# ============================================
# Конфигурация окружения для TG Parser Backend
# ============================================
# Скопируйте этот файл в .env и заполните значения

# Окружение
NODE_ENV=development

# Порт сервера
PORT=4000
API_URL=http://localhost:4000

# ============================================
# База данных (PostgreSQL)
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/tg_parser

# ============================================
# JWT аутентификация
# ============================================
# Секретный ключ для JWT токенов (минимум 32 символа)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Секретный ключ для refresh токенов
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# Telegram API
# ============================================
# Получите на https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=

# ============================================
# CORS
# ============================================
# Разрешённые источники (через запятую)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ============================================
# Redis (опционально)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# Логирование
# ============================================
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Безопасность
# ============================================
BCRYPT_ROUNDS=10
SESSION_SECRET=your-session-secret-change-this
